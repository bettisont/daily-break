// Cloudflare hosting for Daily Break at https://dailybreak.app.
// The deploy copies only index.html and static/ into ./dist, so HANDOFF.md and .git stay private.
// src/worker.js runs first on every request and redirects other hosts (workers.dev, www) to dailybreak.app.
{
  "name": "daily-break",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "dailybreak.app", "custom_domain": true },
    { "pattern": "www.dailybreak.app", "custom_domain": true }
  ],
  // anonymous ranked results (day, level, balls, points) for .github/workflows/results.yml
  "analytics_engine_datasets": [{ "binding": "RESULTS", "dataset": "daily_break_results" }],
  // per-day count of players at each level, for "better than X% of today's players"
  "durable_objects": { "bindings": [{ "name": "DAYS", "class_name": "DayCounts" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DayCounts"] }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true }
}
