// Cloudflare hosting for Daily Break at https://dailybreak.app.
// The deploy (tools/build.sh) copies only index.html, js/ and static/ into ./dist, so HANDOFF.md and .git stay private.
// src/worker.js runs first on every request and redirects other hosts (workers.dev, www) to dailybreak.app.
{
  "name": "daily-break",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "dailybreak.app", "custom_domain": true },
    { "pattern": "www.dailybreak.app", "custom_domain": true }
  ],
  // anonymous ranked results (par days: day, 'par', score to par, strokes, points) for .github/workflows/results.yml
  "analytics_engine_datasets": [
    { "binding": "RESULTS", "dataset": "daily_break_results" },
    { "binding": "EVENTS", "dataset": "daily_break_events" }   // drop-off funnel steps
  ],
  // per-day count of players at each score to par (each level, on old lives days), for "better than X% of today's players"
  "durable_objects": { "bindings": [{ "name": "DAYS", "class_name": "DayCounts" }, { "name": "CARDS", "class_name": "ShareCards" }] },
  // (CARDS: timed-run share cards for /r/<id> link previews, kept 30 days)
  // per-IP caps on POST /api/result and /api/event, so a script can't stuff the tally or the datasets
  "ratelimits": [
    { "name": "RESULT_LIMIT", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "EVENT_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "CARD_LIMIT", "namespace_id": "4103", "simple": { "limit": 5, "period": 60 } }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DayCounts"] }, { "tag": "v2", "new_sqlite_classes": ["ShareCards"] }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true }
}
